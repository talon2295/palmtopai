# Proxy to the relay, shared by every name it answers on.
# Copy to /etc/nginx/snippets/palmtop-proxy.conf and `include` it inside `location /`.

proxy_pass http://127.0.0.1:8787;
proxy_http_version 1.1;

# WebSocket upgrade for /ws (phones), /wait (pairing codes) and /daemon (daemons).
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;

# Never force a name here: the relay accepts `POST /feedback` only when `Origin` matches `Host`,
# and the app opens its WebSocket on the name it was loaded from.
proxy_set_header Host $host;

# Overwrite (never append): the relay trusts the first address for its rate limits.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;

# Daemons and phones send a heartbeat every 20-25 s; keep idle sockets well above that.
proxy_read_timeout 300s;
proxy_send_timeout 300s;
proxy_buffering off;
