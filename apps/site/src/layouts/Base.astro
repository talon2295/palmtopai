---
import '../styles/site.css';
import { canonicalUrl, OG_IMAGE } from '../lib/seo';
import { APP_URL, CLI_VERSION, NAV_LINKS, REPO_URL } from '../lib/site';

interface Props {
    title: string;
    description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = canonicalUrl(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
/** The GitHub mark (Octicons `mark-github`, 16 × 16). */
const GITHUB_ICON =
    'M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z';
const THEMES = [
    {
        value: 'system',
        label: 'System theme',
        icon: 'M4 5h16v11H4zM8 20h8M12 16v4',
    },
    {
        value: 'light',
        label: 'Light theme',
        icon: 'M12 4V2M12 22v-2M4 12H2M22 12h-2M5 5 3.6 3.6M20.4 20.4 19 19M5 19l-1.4 1.4M20.4 3.6 19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z',
    },
    {
        value: 'dark',
        label: 'Dark theme',
        icon: 'M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z',
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="referrer" content="no-referrer" />
        <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="PalmtopAI" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={OG_IMAGE.url} />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:alt" content={OG_IMAGE.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <script is:inline src="/theme-init.js"></script>
        <script src="../scripts/site.ts"></script>
    </head>
    <body>
        <div class="relative isolate min-h-dvh overflow-x-clip">
            <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
                <div class="bg-grid absolute inset-0"></div>
                <div class="bg-blob bg-blob-a"></div>
                <div class="bg-blob bg-blob-b"></div>
                <div class="bg-blob bg-blob-c"></div>
            </div>

            <div
                class="mx-auto flex min-h-dvh max-w-7xl flex-col px-5 pt-[max(1.25rem,env(safe-area-inset-top))] pb-10 sm:px-8 lg:px-12"
            >
                <header class="relative flex items-center justify-between gap-3">
                    <a href="/" class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
                        <img src="/icon.svg" alt="" class="size-8" />
                        <span class="max-[380px]:sr-only">PalmtopAI</span>
                        <span
                            class="rounded-full border border-zinc-300 px-2 py-0.5 text-xs font-medium text-zinc-500 max-sm:hidden dark:border-zinc-700 dark:text-zinc-400"
                            >preview</span
                        >
                    </a>
                    <nav class="flex items-center gap-1 text-sm font-medium">
                        {
                            NAV_LINKS.map((link) => (
                                <a
                                    href={link.href}
                                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                                    class="rounded-lg px-3 py-2 whitespace-nowrap text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-900 aria-[current=page]:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 dark:aria-[current=page]:text-zinc-100 max-md:hidden"
                                >
                                    {link.label}
                                </a>
                            ))
                        }
                        <a
                            href={REPO_URL}
                            aria-label="GitHub"
                            title="GitHub"
                            class="grid size-9 shrink-0 place-items-center rounded-lg text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-900 max-md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
                        >
                            <svg aria-hidden="true" viewBox="0 0 16 16" class="size-5" fill="currentColor">
                                <path d={GITHUB_ICON}></path>
                            </svg>
                        </a>
                        <a
                            href={APP_URL}
                            class="group ml-1 rounded-lg bg-zinc-900 px-3 py-2 whitespace-nowrap text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
                            >Open the app
                            <span class="inline-block transition-transform group-hover:translate-x-0.5"
                                >→</span
                            ></a
                        >
                        <details data-nav-menu class="group/menu md:hidden">
                            <summary
                                aria-label="Menu"
                                class="grid size-9 cursor-pointer list-none place-items-center rounded-lg text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 [&::-webkit-details-marker]:hidden"
                            >
                                <svg
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                    class="size-5"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                >
                                    <path class="group-open/menu:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
                                    <path class="hidden group-open/menu:block" d="M6 6l12 12M18 6 6 18"></path>
                                </svg>
                            </summary>
                            <div
                                class="absolute inset-x-0 top-full z-20 mt-2 flex flex-col gap-0.5 rounded-xl border border-zinc-200 bg-white/95 p-2 text-base shadow-lg backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/95"
                            >
                                {
                                    NAV_LINKS.map((link) => (
                                        <a
                                            href={link.href}
                                            aria-current={isCurrent(link.href) ? 'page' : undefined}
                                            class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 aria-[current=page]:bg-zinc-100 aria-[current=page]:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 dark:aria-[current=page]:bg-zinc-800 dark:aria-[current=page]:text-zinc-100"
                                        >
                                            {link.label}
                                        </a>
                                    ))
                                }
                                <a href={REPO_URL} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 aria-[current=page]:bg-zinc-100 aria-[current=page]:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 dark:aria-[current=page]:bg-zinc-800 dark:aria-[current=page]:text-zinc-100">
                                    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="currentColor">
                                        <path d={GITHUB_ICON}></path>
                                    </svg>
                                    GitHub
                                </a>
                            </div>
                        </details>
                    </nav>
                </header>

                <main class="flex-1">
                    <slot />
                </main>

                <footer
                    class="mt-16 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-zinc-200 pt-6 text-sm text-zinc-500 dark:border-zinc-800"
                >
                    <span class="flex flex-wrap gap-x-4 gap-y-1">
                        <span>PalmtopAI preview</span>
                        <a href="/changelog" class="hover:text-zinc-900 dark:hover:text-zinc-100"
                            >palmtop {CLI_VERSION}</a
                        >
                        <a href="/docs" class="hover:text-zinc-900 dark:hover:text-zinc-100">Docs</a>
                        <a href="/#feedback" class="hover:text-zinc-900 dark:hover:text-zinc-100"
                            >Feedback</a
                        >
                        <a
                            href={`${REPO_URL}/blob/main/LICENSE`}
                            class="hover:text-zinc-900 dark:hover:text-zinc-100"
                            >Open source under Apache 2.0</a
                        >
                    </span>
                    <span class="flex flex-wrap items-center gap-x-4 gap-y-2">
                        <span
                            class="theme-switch inline-flex rounded-lg bg-zinc-200/70 p-0.5 dark:bg-zinc-800"
                            role="group"
                            aria-label="Theme"
                        >
                            {
                                THEMES.map((theme) => (
                                    <button
                                        type="button"
                                        data-theme-choice={theme.value}
                                        aria-pressed={theme.value === 'system' ? 'true' : 'false'}
                                        title={theme.label}
                                        class="grid size-7 place-items-center rounded-md text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
                                    >
                                        <span class="sr-only">{theme.label}</span>
                                        <svg
                                            aria-hidden="true"
                                            viewBox="0 0 24 24"
                                            class="size-4"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d={theme.icon} />
                                        </svg>
                                    </button>
                                ))
                            }
                        </span>
                        <span
                            >Made with <span role="img" aria-label="love" class="text-red-500">♥</span> by
                            <a
                                href="https://github.com/talon2295"
                                class="hover:text-zinc-900 dark:hover:text-zinc-100">Talon</a
                            ></span
                        >
                    </span>
                </footer>
            </div>
        </div>
    </body>
</html>
