---
import { getCollection } from 'astro:content';
import { docsNavigation } from '../lib/docs';
import Base from './Base.astro';

interface Props {
    /** Current page: a docs entry id, or `index` for the overview. */
    id: string;
    title: string;
    description: string;
}
const { id, title, description } = Astro.props;
const entries = await getCollection('docs');
const { ordered, previous, next } = docsNavigation(
    entries.map((entry) => ({ id: entry.id, title: entry.data.title, order: entry.data.order })),
    id,
);
const first = ordered[0];
const links = [{ id: 'index', title: 'Overview', href: '/docs' }].concat(
    ordered.map((doc) => ({ id: doc.id, title: doc.title, href: `/docs/${doc.id}` })),
);
const pageNext = id === 'index' ? first : next;
---

<Base
    title={id === 'index' ? 'PalmtopAI documentation' : `${title} · PalmtopAI docs`}
    description={description}
>
    <div class="grid gap-8 pt-8 md:grid-cols-[13rem_minmax(0,1fr)] md:pt-14 lg:gap-14">
        <nav aria-label="Docs" class="md:sticky md:top-8 md:self-start">
            <details class="group rounded-xl border border-zinc-200 bg-white/80 md:hidden dark:border-zinc-800 dark:bg-zinc-900/70">
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium">
                    <span>Docs: {links.find((link) => link.id === id)?.title}</span>
                    <span class="text-zinc-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
                </summary>
                <ul class="border-t border-zinc-200 px-2 py-2 text-sm dark:border-zinc-800">
                    {
                        links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    aria-current={link.id === id ? 'page' : undefined}
                                    class="block rounded-lg px-3 py-2 text-zinc-600 aria-[current=page]:bg-zinc-100 aria-[current=page]:font-medium aria-[current=page]:text-zinc-900 dark:text-zinc-400 dark:aria-[current=page]:bg-zinc-800 dark:aria-[current=page]:text-zinc-100"
                                >
                                    {link.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </details>
            <ul class="hidden space-y-0.5 text-sm md:block">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                aria-current={link.id === id ? 'page' : undefined}
                                class="block rounded-lg px-3 py-1.5 text-zinc-600 hover:text-zinc-900 aria-[current=page]:bg-zinc-200/60 aria-[current=page]:font-medium aria-[current=page]:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 dark:aria-[current=page]:bg-zinc-800 dark:aria-[current=page]:text-zinc-100"
                            >
                                {link.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <article class="min-w-0 max-w-3xl">
            <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
            <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{description}</p>
            <div class="doc mt-8">
                <slot />
            </div>

            <nav
                aria-label="Previous and next page"
                class="mt-14 grid gap-3 border-t border-zinc-200 pt-6 text-sm sm:grid-cols-2 dark:border-zinc-800"
            >
                {
                    previous && id !== 'index' ? (
                        <a
                            href={`/docs/${previous.id}`}
                            class="rounded-xl border border-zinc-200 p-4 hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
                        >
                            <span class="text-zinc-500">← Previous</span>
                            <span class="mt-1 block font-medium">{previous.title}</span>
                        </a>
                    ) : (
                        <span />
                    )
                }
                {
                    pageNext && (
                        <a
                            href={`/docs/${pageNext.id}`}
                            class="rounded-xl border border-zinc-200 p-4 text-right hover:border-zinc-400 sm:col-start-2 dark:border-zinc-800 dark:hover:border-zinc-600"
                        >
                            <span class="text-zinc-500">Next →</span>
                            <span class="mt-1 block font-medium">{pageNext.title}</span>
                        </a>
                    )
                }
            </nav>
        </article>
    </div>
</Base>
