---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { newestVersionFirst } from '../lib/docs';

const entries = (await getCollection('changelog')).sort((a, b) => newestVersionFirst(a.id, b.id));
const releases = await Promise.all(
    entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Base
    title="Changelog · PalmtopAI"
    description="What changed in each version of palmtop. Update with palmtop update."
>
    <div class="mx-auto max-w-3xl pt-8 md:pt-14">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Changelog</h1>
        <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">
            What changed in each version of palmtop. Your version: <code class="font-mono text-base"
                >palmtop --version</code
            >; update with <code class="font-mono text-base">palmtop update</code>. The app on your devices
            updates by itself.
        </p>

        <ol class="mt-12 space-y-12">
            {
                releases.map(({ entry, Content }) => (
                    <li id={`v${entry.id}`} class="scroll-mt-8">
                        <h2 class="text-2xl font-semibold tracking-tight">
                            <a href={`#v${entry.id}`}>{entry.id}</a>
                        </h2>
                        <p class="mt-1 font-medium text-zinc-700 dark:text-zinc-300">{entry.data.summary}</p>
                        <div class="doc mt-4">
                            <Content />
                        </div>
                    </li>
                ))
            }
        </ol>
    </div>
</Base>
